
# ==========================================
# MiniTwitter - Git Ignore
# Backend: ASP.NET Core
# Frontend: Next.js
# ==========================================


# ==========================================
# .NET / ASP.NET Core
# ==========================================

**/bin/
**/obj/
**/TestResults/

*.user
*.suo
*.rsuser


# ==========================================
# Next.js / React / Node.js
# ==========================================

**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.turbo/
**/.vercel/
**/coverage/

*.tsbuildinfo
next-env.d.ts


# ==========================================
# Variáveis de ambiente
# ==========================================

.env
.env.*
!.env.example
!.env.*.example


# ==========================================
# Configurações locais do .NET
# ==========================================

appsettings.Development.json
appsettings.Production.json
appsettings.*.local.json


# ==========================================
